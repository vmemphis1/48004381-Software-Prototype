:EUAIActAISystemDefinition rdf:type owl:NamedIndividual ,
                                    :DefinitionStatement ;
                           :definesConcept :AISystem ;
                           :definitionText "'AI system' means a machine-based system that is designed to operate with varying levels of autonomy and that may exhibit adaptiveness after deployment, and that, for explicit or implicit objectives, infers, from the input it receives, how to generate outputs such as predictions, content, recommendations, or decisions that can influence physical or virtual environments" ;
                           :hasEvidence :EUAIActDefinitionEvidence ;
                           :statedBy :EU_AI_Act ;
                           rdfs:label "EU AI Act definition of 'AI system'"@en .

