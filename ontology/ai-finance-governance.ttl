@prefix : <https://w3id.org/ai-finance-governance#> .
@prefix afg: <https://w3id.org/ai-finance-governance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix airo: <https://w3id.org/airo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-fbc-fct-fse: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> .
@base <https://w3id.org/ai-finance-governance#> .

# Ontology metadata

<https://w3id.org/ai-finance-governance> rdf:type owl:Ontology ;
                                           owl:imports <https://w3id.org/airo> ;
                                           owl:versionIRI <https://w3id.org/ai-finance-governance/1.6> ;
                                           dcterms:creator "Vahid Teunisse" ;
                                           dcterms:date "2026"^^xsd:gYear ;
                                           dcterms:description "An OWL ontology of AI governance terminology for the financial sector. Maps how Australian and international financial institutions implement AI safety and compliance standards across APRA CPG 234, ASIC RG 271, EU AI Act, NIST AI RMF 1.0, and MAS AIRM regulatory frameworks."@en ;
                                           dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                           dcterms:modified "2026-09-22"^^xsd:date ;
                                           dcterms:title "AI Finance Governance Ontology"@en ;
                                           rdfs:comment "Developed using the Ontology 101 (Noy 2001) + METHONTOLOGY (Fernandez-Lopez 1997) hybrid methodology."@en ;
                                           rdfs:comment "FIBO is reused by mapping rather than by import. The single reused FIBO term is declared locally as a minimal external reference (MIREOT style) and aligned with rdfs:subClassOf, so no FIBO module is loaded at run time. See ORSD section 7.2."@en ;
                                           rdfs:comment "Version 1.4 adopts the project namespace at w3id.org. The redirect registration remains an external publication step documented in README.md."@en ;
                                           owl:versionInfo "1.6"@en .

# Datatypes

xsd:gYear rdf:type rdfs:Datatype .

# Object properties

:addressesRisk rdf:type owl:ObjectProperty ;
               rdfs:domain :GovernanceArtifact ;
               rdfs:range airo:Risk ;
               rdfs:label "addresses risk"@en .

:classifiesSystemAs rdf:type owl:ObjectProperty ;
                    rdfs:domain :RegulatoryFramework ;
                    rdfs:range :RiskTier ;
                    rdfs:label "classifies system as"@en .

:definesConcept rdf:type owl:ObjectProperty ;
                rdfs:domain :DefinitionStatement ;
                rdfs:comment "Links a definition statement to the concept it defines."@en ;
                rdfs:label "defines concept"@en .

:denotesConcept rdf:type owl:ObjectProperty ;
                rdfs:domain :TerminologyUsage ;
                rdfs:comment "Links an observed term usage to a concept instance, such as a particular firm's instance of model risk or responsible AI."@en ;
                rdfs:label "denotes concept"@en .

:disclosesPractice rdf:type owl:ObjectProperty ;
                   rdfs:domain :FirmAIGovernanceDisclosure ;
                   rdfs:range :GovernanceProcess ;
                   rdfs:label "discloses practice"@en .

:disclosesRisk rdf:type owl:ObjectProperty ;
               rdfs:domain :FirmAIGovernanceDisclosure ;
               rdfs:range airo:Risk ;
               rdfs:label "discloses risk"@en .

:embodiesPrinciple rdf:type owl:ObjectProperty ;
                   rdfs:domain :AIGovernancePolicy ;
                   rdfs:range :AIPrinciple ;
                   rdfs:comment "Links a governance policy to a named ethical or responsible-AI principle evidenced in that policy."@en ;
                   rdfs:label "embodies principle"@en .

:extractedFrom rdf:type owl:ObjectProperty ;
               rdfs:domain :EvidenceSnippet ;
               rdfs:range :SourceDocument ;
               rdfs:label "extracted from"@en .

:hasApprovalProcess rdf:type owl:ObjectProperty ;
                    rdfs:domain :FinancialInstitution ;
                    rdfs:range :AIDeploymentApproval ;
                    rdfs:label "has approval process"@en .

:hasEvidence rdf:type owl:ObjectProperty ;
             rdfs:range :EvidenceSnippet ;
             rdfs:label "has evidence"@en .

:hasGovernanceBody rdf:type owl:ObjectProperty ;
                   rdfs:domain :FinancialInstitution ;
                   rdfs:range :AIGovernanceBody ;
                   rdfs:label "has governance body"@en .

:hasGovernanceDisclosure rdf:type owl:ObjectProperty ;
                         rdfs:domain :FinancialInstitution ;
                         rdfs:range :FirmAIGovernanceDisclosure ;
                         rdfs:label "has governance disclosure"@en .

:hasGovernanceFramework rdf:type owl:ObjectProperty ;
                        rdfs:domain :FinancialInstitution ;
                        rdfs:range :AIGovernanceFramework ;
                        rdfs:label "has governance framework"@en .

:hasGovernancePolicy rdf:type owl:ObjectProperty ;
                     rdfs:domain :FinancialInstitution ;
                     rdfs:range :AIGovernancePolicy ;
                     rdfs:label "has governance policy"@en .

:hasGovernanceRequirement rdf:type owl:ObjectProperty ;
                          rdfs:domain :GovernanceArtifact ;
                          rdfs:range :GovernanceRequirement ;
                          rdfs:label "has governance requirement"@en .

:hasRiskTier rdf:type owl:ObjectProperty ;
             rdfs:domain :AISystem ;
             rdfs:range :RiskTier ;
             rdfs:label "has risk tier"@en .

:isSubjectTo rdf:type owl:ObjectProperty ;
             rdfs:domain :FinancialInstitution ;
             rdfs:range :RegulatoryFramework ;
             rdfs:label "is subject to"@en .

:observedInDocument rdf:type owl:ObjectProperty ;
                    rdfs:domain :TerminologyUsage ;
                    rdfs:range :SourceDocument ;
                    rdfs:label "observed in document"@en .

:referencesFramework rdf:type owl:ObjectProperty ;
                     rdfs:domain :AIGovernancePolicy ;
                     rdfs:range :RegulatoryFramework ;
                     rdfs:label "references framework"@en .

:requiresApprovalProcess rdf:type owl:ObjectProperty ;
                         rdfs:domain :AIGovernancePolicy ;
                         rdfs:range :AIDeploymentApproval ;
                         rdfs:label "requires approval process"@en .

:requiresConformityAssessment rdf:type owl:ObjectProperty ;
                              rdfs:domain :RegulatoryFramework ;
                              rdfs:range :ConformityAssessment ;
                              rdfs:label "requires conformity assessment"@en .

:requiresDataGovernance rdf:type owl:ObjectProperty ;
                        rdfs:domain :GovernanceArtifact ;
                        rdfs:range :DataGovernance ;
                        rdfs:comment "Applies to either a regulatory framework or a firm policy that explicitly requires data-governance practices."@en ;
                        rdfs:label "requires data governance"@en .

:requiresHumanOversight rdf:type owl:ObjectProperty ;
                        rdfs:domain :RegulatoryFramework ;
                        rdfs:range :HumanOversight ;
                        rdfs:label "requires human oversight"@en .

:statedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :DefinitionStatement ;
          rdfs:comment "Links a definition statement to the firm or regulatory framework that states it."@en ;
          rdfs:label "stated by"@en .

:supportsAssertion rdf:type owl:ObjectProperty ;
                   rdfs:domain :EvidenceSnippet ;
                   rdfs:comment "Links a snippet to the assertion, individual, or axiom-like resource it supports."@en ;
                   rdfs:label "supports assertion"@en .

:usedByActor rdf:type owl:ObjectProperty ;
             rdfs:domain :TerminologyUsage ;
             rdfs:range :GovernanceActor ;
             rdfs:label "used by actor"@en .

# Datatype properties

:confidenceLevel rdf:type owl:DatatypeProperty ;
                 rdfs:domain :EvidenceSnippet ;
                 rdfs:range xsd:string ;
                 rdfs:label "confidence level"@en .

:definitionText rdf:type owl:DatatypeProperty ;
                rdfs:domain :DefinitionStatement ;
                rdfs:range xsd:string ;
                rdfs:comment "The definition as worded by the source, quoted rather than paraphrased."@en ;
                rdfs:label "definition text"@en .

:documentDate rdf:type owl:DatatypeProperty ;
              rdfs:domain :SourceDocument ;
              rdfs:range xsd:string ;
              rdfs:comment "Publication date, effective date, reporting date, or as-at date as written in the source."@en ;
              rdfs:label "document date"@en .

:documentType rdf:type owl:DatatypeProperty ;
              rdfs:domain :SourceDocument ;
              rdfs:range xsd:string ;
              rdfs:label "document type"@en .

:documentURL rdf:type owl:DatatypeProperty ;
             rdfs:domain :SourceDocument ;
             rdfs:range xsd:anyURI ;
             rdfs:label "document URL"@en .

:exactText rdf:type owl:DatatypeProperty ;
           rdfs:domain :EvidenceSnippet ;
           rdfs:range xsd:string ;
           rdfs:label "exact text"@en .

:extractionDate rdf:type owl:DatatypeProperty ;
                rdfs:domain :EvidenceSnippet ;
                rdfs:range xsd:date ;
                rdfs:label "extraction date"@en .

:jurisdiction rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              rdfs:label "jurisdiction"@en .

:localPath rdf:type owl:DatatypeProperty ;
           rdfs:domain :SourceDocument ;
           rdfs:range xsd:string ;
           rdfs:label "local path"@en .

:pageReference rdf:type owl:DatatypeProperty ;
               rdfs:domain :EvidenceSnippet ;
               rdfs:range xsd:string ;
               rdfs:label "page reference"@en .

:policyURL rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:anyURI ;
           rdfs:label "policy URL"@en .

:retrievalDate rdf:type owl:DatatypeProperty ;
               rdfs:domain :SourceDocument ;
               rdfs:range xsd:date ;
               rdfs:label "retrieval date"@en .

:sectionReference rdf:type owl:DatatypeProperty ;
                  rdfs:domain :EvidenceSnippet ;
                  rdfs:range xsd:string ;
                  rdfs:label "section reference"@en .

:sha256 rdf:type owl:DatatypeProperty ;
        rdfs:domain :SourceDocument ;
        rdfs:range xsd:string ;
        rdfs:label "SHA-256 checksum"@en .

:sourceDocument rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:string ;
                rdfs:label "source document"@en .

:usesTerminology rdf:type owl:DatatypeProperty ;
                 rdfs:domain :TerminologyUsage ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Records the exact term used by a firm or regulator for a given governance concept, enabling cross-institution terminology comparison."@en ;
                 rdfs:label "uses terminology"@en .

# Classes

fibo-fbc-fct-fse:FinancialInstitution rdf:type owl:Class ;
                                      rdfs:label "financial institution"@en ;
                                      skos:definition "financial service provider identified as either a government agency or privately owned entity that collects funds from the public and from other institutions, and invests those funds in financial assets, such as loans, securities, bank deposits, and income-generating property"@en ;
                                      rdfs:comment "External FIBO class reused by mapping only, not redefined here. Label and definition are reproduced verbatim from the FIBO FBC FunctionalEntities FinancialServicesEntities module (EDM Council, MIT License) so the alignment stays traceable without importing the module."@en ;
                                      rdfs:isDefinedBy <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> ;
                                      dcterms:source <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> ;
                                      :retrievalDate "2026-08-31"^^xsd:date ;
                                      :sha256 "f1047cce38f164b6f49bd6c21a340073f0168ff1b36a491e1556b79ad7d6d0da" .

:AIDeploymentApproval rdf:type owl:Class ;
                      rdfs:subClassOf :GovernanceProcess ;
                      rdfs:comment "An internal review and sign-off process a firm must complete before deploying an AI system into production."@en ;
                      rdfs:label "AI Deployment Approval Process"@en ;
                      skos:altLabel "AI Model Validation"@en ,
                                    "AI Pre-deployment Review"@en ,
                                    "Model Approval Process"@en .

:AIFinanceGovernanceConcept rdf:type owl:Class ;
                            rdfs:comment "Root concept for the AI Finance Governance Ontology classification tree."@en ;
                            rdfs:label "AI Finance Governance Concept"@en .

:AIGovernanceBody rdf:type owl:Class ;
                  rdfs:subClassOf :GovernanceActor ;
                  rdfs:comment "An internal committee, board, or function within a firm responsible for AI oversight and accountability."@en ;
                  rdfs:label "AI Governance Body"@en ;
                  skos:altLabel "AI Ethics Board"@en ,
                                "AI Risk Committee"@en ,
                                "Model Risk Committee"@en ,
                                "Technology Risk Committee"@en .

:AIGovernanceFramework rdf:type owl:Class ;
                       rdfs:subClassOf :GovernanceArtifact ;
                       rdfs:comment "A framework, toolkit, or structured set of controls used by a firm to govern AI. It is broader than, and must not automatically be treated as, a published formal AI policy."@en ;
                       rdfs:label "AI Governance Framework"@en ;
                       skos:altLabel "AI Governance Toolkit"@en ,
                                     "Responsible AI Framework"@en .

:AIGovernancePolicy rdf:type owl:Class ;
                    rdfs:subClassOf :GovernanceArtifact ;
                    rdfs:comment "A formal document published by a firm or regulator that sets out principles, rules, or standards for the development, deployment, and oversight of AI systems."@en ;
                    rdfs:label "AI Governance Policy"@en ;
                    skos:altLabel "AI Ethics Policy"@en ,
                                  "AI Framework"@en ,
                                  "AI Policy"@en ,
                                  "Responsible AI Policy"@en .

:AIPrinciple rdf:type owl:Class ;
             rdfs:subClassOf :AIFinanceGovernanceConcept ;
             rdfs:comment "A principle or quality used to assess responsible, trustworthy, or well-governed AI."@en ;
             rdfs:label "AI Principle"@en .

:AISystem rdf:type owl:Class ;
          rdfs:subClassOf :AIFinanceGovernanceConcept ,
                          airo:AISystem ;
          rdfs:comment "An AI-based machine system that makes predictions, recommendations, or decisions influencing real or virtual environments."@en ;
          rdfs:comment "Intentionally has no concrete system instances: the study compares governance obligations and terminology rather than cataloguing deployed systems. Retained because the EU AI Act and NIST AI RMF both define this regulated subject, and CQ4 points their definitions to this class."@en ;
          dcterms:source :EUAIActDocument ,
                         :NISTAIRMFDocument ;
          rdfs:label "AI System"@en ;
          skos:altLabel "Artificial Intelligence System"@en ,
                        "Automated Decision System"@en .

:AlgorithmicBias rdf:type owl:Class ;
                 rdfs:subClassOf airo:Risk ;
                 rdfs:comment "Systematic and unfair discrimination in AI outputs, typically arising from training data, model design, or system deployment context."@en ;
                 rdfs:label "Bias"@en ;
                 skos:altLabel "AI Fairness Risk"@en ,
                               "Algorithmic Bias"@en ,
                               "Unfair Discrimination"@en .

:ConformityAssessment rdf:type owl:Class ;
                      rdfs:subClassOf :GovernanceProcess ;
                      rdfs:comment "A process to demonstrate that an AI system meets the requirements of an applicable regulatory framework before deployment or market placement."@en ;
                      rdfs:label "Conformity Assessment"@en ;
                      skos:altLabel "Compliance Assessment"@en ,
                                    "Regulatory Audit"@en .

:DataGovernance rdf:type owl:Class ;
                rdfs:subClassOf :GovernanceProcess ;
                rdfs:comment "Policies and processes ensuring that data used to train and operate AI systems is accurate, complete, representative, and fit for purpose."@en ;
                rdfs:label "Data Governance"@en ;
                skos:altLabel "Data Quality Management"@en ,
                              "Data Stewardship"@en .

:DefinitionStatement rdf:type owl:Class ;
                     rdfs:subClassOf :GovernanceArtifact ;
                     rdfs:comment "A definition of a concept as stated by a named source, whether a firm or a regulatory framework. Used to compare how different sources define the same concept."@en ;
                     rdfs:label "Definition Statement"@en .

:EvidenceArtifact rdf:type owl:Class ;
                  rdfs:subClassOf :AIFinanceGovernanceConcept ;
                  rdfs:comment "A document, snippet, or extraction record used to support knowledge graph assertions."@en ;
                  rdfs:label "Evidence Artifact"@en .

:EvidenceSnippet rdf:type owl:Class ;
                 rdfs:subClassOf :EvidenceArtifact ;
                 rdfs:comment "A short excerpt, paraphrase, or source-specific note that supports a knowledge graph assertion."@en ;
                 rdfs:label "Evidence Snippet"@en .

:Explainability rdf:type owl:Class ;
                rdfs:subClassOf :AIPrinciple ;
                rdfs:comment "The degree to which the outputs and decision logic of an AI system can be understood by human stakeholders."@en ;
                rdfs:label "Explainability"@en ;
                skos:altLabel "Interpretability"@en ,
                              "Transparency"@en .

:ExplainabilityObligation rdf:type owl:Class ;
                          rdfs:subClassOf :GovernanceRequirement ;
                          rdfs:comment "Reclassified in version 1.3. Previously a direct subclass of :GovernanceObligation, which made it a SIBLING of :GovernanceRequirement. Because :hasGovernanceRequirement has range :GovernanceRequirement, no property could link a regulatory framework to an explainability obligation, so competency question 3 was unanswerable as modelled. An explainability obligation is a requirement a framework imposes, so subsuming it under :GovernanceRequirement is the correct reading and keeps the obligation/requirement distinction intact."@en ;
                          rdfs:comment "A regulatory or policy requirement that AI system outputs and decisions be interpretable and explainable to affected parties."@en ;
                          rdfs:label "Explainability Obligation"@en ;
                          skos:altLabel "Interpretability Obligation"@en ,
                                        "Right to Explanation"@en ,
                                        "Transparency Requirement"@en .

:FinancialInstitution rdf:type owl:Class ;
                      rdfs:subClassOf :GovernanceActor ,
                                      fibo-fbc-fct-fse:FinancialInstitution ;
                      rdfs:comment "A firm operating in the financial sector that is subject to AI governance obligations and whose disclosures are analysed in this study."@en ;
                      rdfs:label "Financial Institution"@en .

:FirmAIGovernanceDisclosure rdf:type owl:Class ;
                            rdfs:subClassOf :GovernanceArtifact ,
                                            :SourceDocument ;
                            rdfs:comment "A public firm document or web page that contains evidence about AI governance. A disclosure is not automatically a formal AI governance policy."@en ;
                            rdfs:label "Firm AI Governance Disclosure"@en .

:GenerativeAIRisk rdf:type owl:Class ;
                  rdfs:subClassOf airo:Risk ;
                  rdfs:comment "Risk arising from generative AI, including inaccurate output, bias, privacy, intellectual-property, security, or misuse concerns."@en ;
                  rdfs:label "Generative AI Risk"@en .

:GovernanceActor rdf:type owl:Class ;
                 rdfs:subClassOf :AIFinanceGovernanceConcept ;
                 rdfs:comment "A person, organisation, committee, or function that participates in AI governance."@en ;
                 rdfs:label "Governance Actor"@en .

:GovernanceArtifact rdf:type owl:Class ;
                    rdfs:subClassOf :AIFinanceGovernanceConcept ;
                    rdfs:comment "A policy, framework, standard, report, or other artefact that records AI governance rules or commitments."@en ;
                    rdfs:label "Governance Artifact"@en .

:GovernanceObligation rdf:type owl:Class ;
                      rdfs:subClassOf :AIFinanceGovernanceConcept ;
                      rdfs:comment "A requirement imposed by a regulatory framework, standard, or internal policy."@en ;
                      rdfs:label "Governance Obligation"@en .

:GovernanceProcess rdf:type owl:Class ;
                   rdfs:subClassOf :AIFinanceGovernanceConcept ;
                   rdfs:comment "A repeatable activity or control process used to govern AI systems."@en ;
                   rdfs:label "Governance Process"@en .

:GovernanceRequirement rdf:type owl:Class ;
                       rdfs:subClassOf :GovernanceObligation ;
                       rdfs:comment "A specific requirement, control expectation, or obligation stated in a policy, standard, or regulatory framework."@en ;
                       rdfs:label "Governance Requirement"@en .

:HighRiskAISystem rdf:type owl:Class ;
                  rdfs:subClassOf :AISystem ;
                  rdfs:comment "An AI system classified as high-risk under a regulatory framework, subject to enhanced governance requirements."@en ;
                  rdfs:comment "Intentionally has no deployed-system instances. It is retained as an expectation-only class because Article 6 of the EU AI Act defines the high-risk category; the populated :HighRiskTier captures the regulatory vocabulary without inventing firm systems."@en ;
                  dcterms:source :EUAIActDocument ;
                  rdfs:label "High-Risk AI System"@en .

:HighRiskTier rdf:type owl:Class ;
              rdfs:subClassOf :RiskTier ;
              rdfs:comment "A risk classification level indicating that an AI system is subject to enhanced governance requirements."@en ;
              rdfs:label "High Risk Tier"@en ;
              skos:altLabel "High-Impact AI"@en ,
                            "Tier 1 AI"@en .

:HumanOversight rdf:type owl:Class ;
                rdfs:subClassOf :GovernanceProcess ;
                rdfs:comment "The ability of humans to monitor, understand, intervene in, and where necessary override the outputs or decisions of an AI system."@en ;
                rdfs:label "Human Oversight"@en ;
                skos:altLabel "Human Control"@en ,
                              "Human Supervision"@en ,
                              "Human-in-the-Loop"@en .

:ModelRisk rdf:type owl:Class ;
           rdfs:subClassOf airo:Risk ;
           rdfs:comment "The risk of adverse consequences from decisions based on incorrect, misused, or poorly governed AI/statistical models."@en ;
           rdfs:label "Model Risk"@en ;
           skos:altLabel "AI Risk"@en ,
                         "Algorithmic Risk"@en ,
                         "Model Governance Risk"@en .

:ModelRiskPolicy rdf:type owl:Class ;
                 rdfs:subClassOf :GovernanceArtifact ;
                 rdfs:comment "A formal internal policy governing model risk, including model monitoring, validation, approval, and use controls."@en ;
                 rdfs:label "Model Risk Policy"@en .

:ModelValidation rdf:type owl:Class ;
                 rdfs:subClassOf :AIDeploymentApproval ;
                 rdfs:comment "Independent or controlled review, testing, re-validation, and approval of a model before implementation or continued use."@en ;
                 rdfs:label "Model Validation"@en .

:RegulatoryFramework rdf:type owl:Class ;
                     rdfs:subClassOf :GovernanceArtifact ;
                     rdfs:comment "A formal set of rules, standards, or guidelines issued by a regulatory authority governing AI systems in financial services."@en ;
                     rdfs:label "Regulatory Framework"@en ;
                     skos:altLabel "AI Regulation"@en ,
                                   "Governance Standard"@en .

:ResponsibleAI rdf:type owl:Class ;
               rdfs:subClassOf :AIPrinciple ;
               rdfs:comment "A set of principles for developing and deploying AI systems in an ethical, transparent, accountable, and human-centred manner."@en ;
               rdfs:label "Responsible AI"@en ;
               skos:altLabel "Ethical AI"@en ,
                             "Human-Centred AI"@en ,
                             "Trustworthy AI"@en .

:RiskTier rdf:type owl:Class ;
          rdfs:subClassOf :AIFinanceGovernanceConcept ;
          rdfs:comment "A classification level assigned to an AI system based on its assessed risk, used to determine applicable governance obligations."@en ;
          rdfs:label "Risk Tier"@en ;
          skos:altLabel "AI Risk Category"@en ,
                        "Risk Classification"@en .

:SourceDocument rdf:type owl:Class ;
                rdfs:subClassOf :EvidenceArtifact ;
                rdfs:comment "A regulatory document, standard, annual report, policy page, or firm disclosure used as a source for knowledge graph population."@en ;
                rdfs:label "Source Document"@en .

:TerminologyUsage rdf:type owl:Class ;
                  rdfs:subClassOf :EvidenceArtifact ;
                  rdfs:comment "An observed use of a term by a firm, regulator, or standard-setting body, linked to the concept it denotes and the source where it appears."@en ;
                  rdfs:label "Terminology Usage"@en .

:ThirdPartyAIGovernance rdf:type owl:Class ;
                        rdfs:subClassOf :GovernanceProcess ;
                        rdfs:comment "Policies and processes governing the use of AI systems provided by external vendors or service providers."@en ;
                        rdfs:label "Third-Party AI Governance"@en ;
                        skos:altLabel "AI Outsourcing Risk"@en ,
                                      "Third-Party Model Risk"@en ,
                                      "Vendor AI Risk"@en .

airo:AISystem rdf:type owl:Class .

airo:Risk rdf:type owl:Class .

# Financial institutions and regulatory frameworks

:ANZ rdf:type owl:NamedIndividual ,
              :FinancialInstitution ;
     :hasApprovalProcess :ANZModelMonitoringAndRevalidation ;
     :hasGovernanceDisclosure :ANZ2024AnnualReport ;
     :hasGovernanceFramework :ANZAIGovernanceFramework2024 ;
     :jurisdiction "Australia" ;
     rdfs:label "ANZ Banking Group"@en ;
     skos:altLabel "ANZ"@en .

:APRA_CPG234 rdf:type owl:NamedIndividual ,
                      :RegulatoryFramework ;
             :jurisdiction "Australia" ;
             dcterms:description "Australian Prudential Regulation Authority Prudential Practice Guide 234 — Information Security."@en ;
             rdfs:label "APRA CPG 234"@en .

:ASIC_RG271 rdf:type owl:NamedIndividual ,
                     :RegulatoryFramework ;
            :jurisdiction "Australia" ;
            dcterms:description "Australian Securities and Investments Commission Regulatory Guide 271 — Internal Dispute Resolution (covers AI-assisted decisions)."@en ;
            rdfs:label "ASIC RG 271"@en .

:AustralianAIEthicsPrinciples rdf:type owl:NamedIndividual ,
                                       :RegulatoryFramework ;
                              :jurisdiction "Australia" ;
                              dcterms:description "Australia's AI Ethics Principles, eight voluntary principles published by the Department of Industry, Science and Resources."@en ;
                              rdfs:comment "Represented as a regulatory framework, resolving the open question recorded in ORSD section 18. The framework is voluntary rather than binding, which is the same status already carried by the NIST AI RMF, so a separate 'reference framework' class would add a distinction the competency questions never draw. The publisher records the principles in the past tense and states that they have been evolved by the Guidance for AI Adoption of 21 October 2025; they are retained because competency question 4 names them explicitly and because firm policies in this corpus still mirror their wording."@en ;
                              rdfs:label "Australia's AI Ethics Principles"@en ;
                              skos:altLabel "AI Ethics Principles"@en .

:AustralianAIEthicsPrinciples :hasGovernanceRequirement :AUAIEthicsExplainability .

:CommonwealthBank rdf:type owl:NamedIndividual ,
                           :FinancialInstitution ;
                  :hasGovernanceDisclosure :CBA2024AnnualReport ,
                                           :CBAArtificialIntelligenceApproachPage ;
                  :hasGovernanceFramework :CBAResponsibleAIToolkit2024 ;
                  :hasGovernancePolicy :CBAArtificialIntelligenceApproach ;
                  :jurisdiction "Australia" ;
                  :policyURL "https://www.commbank.com.au/about-us/opportunity-initiatives/policies-and-practices/artificial-intelligence.html"^^xsd:anyURI ;
