# Corpus expansion (2026-09-22)
@prefix : <https://w3id.org/ai-finance-governance#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Expansion vocabulary

:GovernanceStatement a owl:Class ;
    rdfs:label "Evidence-backed governance statement"@en ;
    rdfs:comment "A scoped source assertion. Distinguishes published commitments, report findings, guidance and consultation positions; does not establish implementation or compliance."@en ;
    rdfs:subClassOf :GovernanceArtifact .

:hasStatement a owl:ObjectProperty ;
    rdfs:label "has governance statement"@en ;
    rdfs:range :GovernanceStatement .

:statementStatus a owl:DatatypeProperty ;
    rdfs:label "statement status"@en ;
    rdfs:domain :GovernanceStatement ;
    rdfs:range xsd:string .

:statementText a owl:DatatypeProperty ;
    rdfs:label "statement summary"@en ;
    rdfs:domain :GovernanceStatement ;
    rdfs:range xsd:string .

:statementTopic a owl:DatatypeProperty ;
    rdfs:label "statement topic"@en ;
    rdfs:domain :GovernanceStatement ;
    rdfs:range xsd:string .

