# Published firm statements relevant to citizens and customers.
PREFIX : <https://w3id.org/ai-finance-governance#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT DISTINCT ?actor ?topic ?statement ?status ?document ?date ?page
WHERE {
  ?actor a :FinancialInstitution .
  ?actor :hasStatement ?statement .
  ?statement :statementTopic ?topic ; :statementStatus ?status ; :hasEvidence ?evidence .
  VALUES ?topic { "Privacy" "Fairness" "Transparency" "Human oversight" "Contestability" }
  ?evidence :extractedFrom ?document ; :pageReference ?page .
  ?document :documentDate ?date .
}
ORDER BY ?actor ?topic ?date ?statement
